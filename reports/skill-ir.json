    ]
  },
  "risk": {
    "output_risk": "high",
    "execution_risk": "medium",
    "trust_boundary": "external-evidence-dependent"
  },
  "governance": {
    "review_due": "2026-11-20",
    "review_cadence": "quarterly",
    "release_gates": [
      "intent_capture",
      "prior_art_research",
      "keep_adapt_reject_invent_ledger",
      "provider_and_license_boundary",
      "root_entrypoint_isolation",
      "trigger_regression",
      "route_regression",
      "context_budget",
      "skill_ir",
      "secret_scan",
      "evidence_bound_public_claims",
      "feature_branch_only_publication",
      "pull_request_review_and_check_gate",
      "released_version_immutability",
      "github_release_creation",
      "npx_discovery_and_clean_install"
    ],
    "publication": "feature branch -> pull request -> versioned release -> discovery -> clean install"
  },
  "portability": {
    "platforms": [
      "openai",
      "claude",
      "generic",
      "agent-skills-compatible",
      "vscode"
    ],
    "runtime": "agent-skills canonical source; Python scripts are optional deterministic QA helpers",
    "degradation": "provider fallback and evidence-state reporting are required"
  },
  "evidence_boundary": {
    "static_tests_prove": [
      "package shape",
      "trigger boundary fixtures",
      "route regression",
      "script behavior"
    ],
    "static_tests_do_not_prove": [
      "current-world factual correctness",
      "provider availability",
      "human usefulness",
      "professional advice"
    ],
    "output_evidence_file": "reports/output-evidence.json"
  }
}
